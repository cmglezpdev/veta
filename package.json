{
  "name": "@cmglezpdev/veta",
  "version": "0.11.0",
  "description": "Turn YouTube videos into clean, structured, AI-ready notes",
  "bin": {
    "veta": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:live": "VETA_LIVE_TEST=1 vitest run src/adapters/ytdlp/ytdlp-extraction-source.live.test.ts"
  },
  "keywords": [
    "youtube",
    "transcript",
    "obsidian",
    "ai"
  ],
  "author": "cmglezpdev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmglezpdev/veta.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "dependencies": {
    "yargs": "^18.1.0",
    "youtube-dl-exec": "^3.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/yargs": "^17.0.35",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
