{
  "name": "@cmglezpdev/veta",
  "version": "0.1.0",
  "description": "Turn YouTube videos into clean, structured, AI-ready notes",
  "main": "index.js",
  "bin": {
    "veta": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "vitest run"
  },
  "keywords": [
    "youtube",
    "transcript",
    "obsidian",
    "ai"
  ],
  "author": "cmglezpdev",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.17.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "youtube-dl-exec": "^3.1.9"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
